# Sacred Canopy — data pipeline configuration
# Copy this file to `.env` (which is gitignored) and fill in real values.
# These are only needed to run the Google Sheets/Drive sync scripts in scripts/,
# NOT to build or run the site itself.

# Absolute path to the Google service-account JSON key.
# Defaults to ../keys/sacred-canopy-*.json relative to the app if unset.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
